# Copy to grafana/.env (separate from the app's .env).
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# Change this; Grafana asks for a new one on first login when left at "admin".
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=15d
# Alloy's OTLP ports on the host, for apps not running in Docker (e.g. scripts/test_mode.sh).
ALLOY_OTLP_GRPC_PORT=4317
ALLOY_OTLP_HTTP_PORT=4318
ALLOY_UI_PORT=12345
