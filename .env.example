# Claude credential: set exactly ONE of these (see "Terms of use" in the README).
# Subscription token, for your own personal use only. Generate it with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API key (Claude Console), required if anyone other than you will use this server.
# ANTHROPIC_API_KEY=

# Signs the admin session cookie. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First admin account, created on startup if no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Host port to publish the API/dashboard on.
PORT=8000

# Set to true when served over HTTPS (behind a TLS-terminating proxy).
SESSION_COOKIE_SECURE=false

# Claude Code version baked into the image.
CLAUDE_CODE_VERSION=2.1.281

# OpenTelemetry (optional): send traces, metrics and logs over OTLP, e.g. to Grafana Alloy.
# Unset = off. See docs/operations.md → Observability.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
