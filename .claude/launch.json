{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SECRET_KEY=dev-only-secret",
        "ADMIN_USERNAME=admin",
        "ADMIN_PASSWORD=dev-password",
        "DATABASE_URL=sqlite:///./dev.db",
        "CLAUDE_DATA_DIR=./.dev-claude",
        ".venv/bin/uvicorn",
        "app.main:app",
        "--reload",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "api-test-mode",
      "runtimeExecutable": "scripts/test_mode.sh",
      "runtimeArgs": [
        "--fresh"
      ],
      "port": 8020
    },
    {
      "name": "api-test-mode-otel",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318",
        "OTEL_METRIC_EXPORT_INTERVAL=10000",
        "OTEL_RESOURCE_ATTRIBUTES=deployment.environment=test-mode",
        "scripts/test_mode.sh",
        "--fresh"
      ],
      "port": 8020
    }
  ]
}
